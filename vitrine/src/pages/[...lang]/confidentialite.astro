---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import { company, content, LANGS, DEFAULT, UI } from '../../site.js';
export function getStaticPaths() { return LANGS.map(l => ({ params: { lang: l === DEFAULT ? undefined : l }, props: { lang: l } })); }
const { lang } = Astro.props; const C = content(lang); const T = UI[lang] || UI.fr;
---
<Base lang={lang} path="/confidentialite/" title={T.priv_title} noindex>
  <section class="hero"><h1>{T.priv_title}</h1><p>{T.priv_sub}</p></section>
  <section>
    <h2>{T.priv_what}</h2><p>{T.priv_what_text}</p>
    <h2>{T.priv_why}</h2><p>{T.priv_why_text}</p>
    <h2>{T.priv_how_long}</h2><p>{T.priv_how_long_text}</p>
    <h2>{T.priv_rights}</h2><p>{T.priv_rights_text} {company.contact?.email}. {T.priv_law}</p>
  </section>
</Base>
