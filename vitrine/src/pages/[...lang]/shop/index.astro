---
import Base from '../../../layouts/Base.astro';
import ContactForm from '../../../components/ContactForm.astro';
import Basket from '../../../components/Basket.astro';
import { fiche, products, shop, chf, shopEnabled } from '../../../site.js';
import { company, content, LANGS, DEFAULT, UI } from '../../../site.js';
export function getStaticPaths() { if (!shopEnabled) return []; return LANGS.map(l => ({ params: { lang: l === DEFAULT ? undefined : l }, props: { lang: l } })); }
const { lang } = Astro.props; const C = content(lang); const T = UI[lang] || UI.fr; const initial = n => String(n).replace(/[«»"“”]/g, '').trim().slice(0, 1).toUpperCase();
---
<Base lang={lang} path="/shop/" title={T.nav_shop} description={C.shop?.text}>
  <section style="padding-bottom:12px"><h1 class="page">{C.shop?.title || T.nav_shop}</h1><p class="note" style="font-size:1.05rem;max-width:60ch">{C.shop?.text}</p></section>
  <div class="products">{products.map(p0 => fiche(p0, lang)).map(p => <div class="product"><a class={p.image ? "ph has-img" : "ph"} href={(lang === DEFAULT ? '' : '/' + lang) + '/shop/produit/' + p.id + '/'} aria-label={p.name}>{p.image ? <img src={p.image} alt={p.name} loading="lazy" /> : <span>{initial(p.name)}</span>}</a><div class="b"><h3><a href={(lang === DEFAULT ? '' : '/' + lang) + '/shop/produit/' + p.id + '/'}>{p.name}</a></h3><p>{p.description}</p><span class="stock">{p.stock === null || p.stock === undefined ? T.made_to_order : p.stock > 0 ? `${p.stock} ${T.in_stock}` : (C.shop?.soldout || 'Épuisé')}</span><div class="row"><div class="price">{chf(p.price_cents)} CHF</div><button class="btn sm" type="button" data-add={p.id} data-name={p.name} data-price={p.price_cents} disabled={p.stock === 0}>{C.shop?.add || 'Ajouter'}</button></div></div></div>)}</div>
  <p class="note">{shop.vat_registered ? T.vat_note_reg : T.vat_note}</p>
  <script>
    document.querySelectorAll('[data-add]').forEach(b => b.addEventListener('click', () => { let c = []; try { c = JSON.parse(localStorage.getItem('maic-basket') || '[]'); } catch (e) {} const id = +b.dataset.add, it = c.find(i => i.id === id); if (it) it.qty++; else c.push({ id, name: b.dataset.name, price_cents: +b.dataset.price, qty: 1 }); localStorage.setItem('maic-basket', JSON.stringify(c)); const e = document.getElementById('basket-count'); if (e) e.textContent = c.reduce((a, i) => a + i.qty, 0); const l = b.textContent; b.textContent = '✓'; setTimeout(() => { b.textContent = l; }, 900); }));
  </script>
</Base>
