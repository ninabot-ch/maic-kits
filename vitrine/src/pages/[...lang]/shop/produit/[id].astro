---
import Base from '../../../../layouts/Base.astro';
import { company, content, LANGS, DEFAULT, UI, products, shop, chf, shopEnabled } from '../../../../site.js';
export function getStaticPaths() { const out = []; if (!shopEnabled) return out; for (const l of LANGS) for (const p of products) out.push({ params: { lang: l === DEFAULT ? undefined : l, id: String(p.id) }, props: { lang: l, product: p } }); return out; }
const { lang, product: p } = Astro.props; const C = content(lang); const T = UI[lang] || UI.fr; const initial = n => String(n).replace(/[«»"“”]/g, '').trim().slice(0, 1).toUpperCase();
---
<Base lang={lang} path={'/shop/produit/' + p.id + '/'} title={p.name} description={p.description}>
  <section class="product-hero"><div class="ph" aria-hidden="true"><span>{initial(p.name)}</span></div><div><h1 class="page">{p.name}</h1><p class="note" style="font-size:1.05rem;margin:14px 0">{p.description}</p><div class="price" style="font-size:1.6rem">{chf(p.price_cents)} CHF</div><p class="stock">{p.stock === null || p.stock === undefined ? T.made_to_order : p.stock > 0 ? `${p.stock} ${T.in_stock}` : (C.shop?.soldout || 'Épuisé')}</p>
    <p><button class="btn" type="button" data-add={p.id} data-name={p.name} data-price={p.price_cents} disabled={p.stock === 0}>{C.shop?.add || 'Ajouter'}</button> <a class="btn ghost" href={(lang === DEFAULT ? '' : '/' + lang) + '/shop/panier/'}>{T.basket}</a></p>
    <p class="note">{shop.vat_registered ? T.vat_note_reg : T.vat_note}{shop.delivery_days ? ` · ${shop.delivery_days} j` : ''}</p></div></section>
  <script>
    document.querySelectorAll('[data-add]').forEach(b => b.addEventListener('click', () => { let c = []; try { c = JSON.parse(localStorage.getItem('maic-basket') || '[]'); } catch (e) {} const id = +b.dataset.add, it = c.find(i => i.id === id); if (it) it.qty++; else c.push({ id, name: b.dataset.name, price_cents: +b.dataset.price, qty: 1 }); localStorage.setItem('maic-basket', JSON.stringify(c)); const e = document.getElementById('basket-count'); if (e) e.textContent = c.reduce((a, i) => a + i.qty, 0); const l = b.textContent; b.textContent = '✓'; setTimeout(() => { b.textContent = l; }, 900); }));
  </script>
</Base>
