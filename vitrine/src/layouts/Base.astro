---
import { company, content, site, LANGS, DEFAULT, UI, prefix, tagline, shopEnabled } from '../site.js';
const { title, description, noindex = false, lang = DEFAULT, path = '/', image = null } = Astro.props;
const accent = company.accent || '#1E8C8A'; const T = UI[lang] || UI.fr; const p = prefix(lang); const tg = tagline(lang);
const alt = LANGS.map(l => ({ l, href: site + prefix(l) + path }));
// Un site neuf n'a pas de contenu : la barre de navigation ne pointe que vers des sections qui existent.
const _c = content(lang); const _has = v => typeof v === 'string' && v.trim().length > 0;
const hasServices = (_c.services || []).some(x => _has(x?.title) || _has(x?.text));
const hasAbout = _has(_c.about?.title) || _has(_c.about?.text);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title ? `${title} · ${company.name}` : `${company.name} — ${tg}`}</title>
  <meta name="description" content={description || tg}>
  <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'}>
  <link rel="canonical" href={site + p + path}>
  {alt.map(a => <link rel="alternate" hreflang={a.l} href={a.href} />)}
  <link rel="alternate" hreflang="x-default" href={site + path}>
  <meta property="og:title" content={title || company.name}><meta property="og:description" content={description || tg}><meta property="og:type" content="website"><meta property="og:url" content={site + p + path}><meta property="og:site_name" content={company.name}>{image ? <meta property="og:image" content={site + image} /> : null}<meta property="og:locale" content={lang === 'fr' ? 'fr_CH' : 'en_GB'}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Manrope:wght@500;600;700&display=swap">
  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"LocalBusiness","name":company.name,"description":tg,"url":site,"email":company.contact?.email,"address":{"@type":"PostalAddress","addressLocality":company.contact?.city,"addressCountry":"CH"}})}></script>
  <style is:global define:vars={{ accent }}>
    /* MyAiCompany kit — global, piloté par la couleur d'accent de company.yaml ; typographie soignée, pas de dépendance */
    :root{--ink:#1B1D22;--muted:#646A76;--faint:#9AA0AA;--bg:#F7F6F3;--panel:#FFFFFF;--panel-2:#F1EFEA;--line:#E5E2DB;--r:16px;--accent-ink:#fff}
    *{box-sizing:border-box}html{scroll-behavior:smooth}html,body{margin:0}
    body{background:var(--bg);color:var(--ink);font:16px/1.6 "Manrope",ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}
    a{color:inherit}img{max-width:100%;height:auto}
    h1,h2,h3{font-family:"Fraunces","Iowan Old Style",Georgia,serif;font-weight:600;letter-spacing:-.015em;text-wrap:balance;margin:0}
    h1{font-size:clamp(2.4rem,5.5vw,4rem);line-height:1.02}h1.page{font-size:clamp(2rem,4vw,3rem);margin-bottom:10px}h2{font-size:clamp(1.6rem,3vw,2.2rem);line-height:1.15;margin-bottom:14px}h3{font-size:1.15rem;line-height:1.3}
    p{margin:0 0 12px}.note{font-size:.9rem;color:var(--muted)}
    .wrap{max-width:1080px;margin:0 auto;padding:0 clamp(16px,4vw,32px)}
    header.top{display:flex;align-items:center;gap:18px;padding:22px 0;flex-wrap:wrap}
    header.top .brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-family:"Fraunces",Georgia,serif;font-weight:600;font-size:1.25rem;letter-spacing:-.01em}
    header.top .brand i{width:34px;height:34px;border-radius:10px;background:var(--accent);color:var(--accent-ink);display:grid;place-items:center;font-style:normal;font-weight:700;font-size:1rem}
    header.top nav{margin-left:auto;display:flex;gap:4px;align-items:center;flex-wrap:wrap}
    header.top nav a{text-decoration:none;color:var(--muted);font-weight:600;font-size:.95rem;padding:8px 12px;border-radius:999px}header.top nav a:hover{color:var(--ink);background:var(--panel)}
    header.top nav .lang{border:1px solid var(--line);color:var(--ink);font-size:.85rem;padding:6px 11px}
    header.top nav .basket{color:var(--ink)}header.top nav .basket b{background:var(--accent);color:var(--accent-ink);border-radius:999px;padding:1px 8px;font-size:.8rem;margin-left:4px}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--ink);color:#fff;text-decoration:none;padding:13px 22px;border-radius:999px;font:inherit;font-weight:700;border:0;cursor:pointer;line-height:1.1;transition:transform .12s,background .12s}
    .btn:hover{background:var(--accent);color:var(--accent-ink);transform:translateY(-1px)}.btn.sm{padding:9px 15px;font-size:.92rem;white-space:nowrap}
    .btn.ghost{background:transparent;color:var(--ink);border:1.5px solid var(--line)}.btn.ghost:hover{background:var(--panel-2);color:var(--ink);border-color:var(--ink)}
    .btn:disabled{opacity:.45;cursor:default;transform:none}
    .btn:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
    /* héros : texte + panneau d'accent (la marque n'a pas encore de photo : on lui donne une matière) */
    .hero{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:clamp(24px,5vw,64px);align-items:center;padding:clamp(28px,5vw,64px) 0 clamp(36px,6vw,72px)}
    @media (max-width:820px){.hero{grid-template-columns:minmax(0,1fr)}}
    .hero .kicker{font-weight:700;font-size:.8rem;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);margin-bottom:14px}
    .hero p.lead{font-size:clamp(1.05rem,1.5vw,1.25rem);color:var(--muted);margin:20px 0 26px;max-width:52ch}
    .hero .cta{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
    .hero .art{aspect-ratio:4/3;border-radius:24px;background:radial-gradient(120% 90% at 20% 15%,color-mix(in srgb,var(--accent) 55%,#fff) 0%,var(--accent) 45%,color-mix(in srgb,var(--accent) 60%,#1B1D22) 100%);position:relative;overflow:hidden;box-shadow:0 30px 60px -32px color-mix(in srgb,var(--accent) 60%,#000)}
    .hero .art::before{content:"";position:absolute;inset:auto -10% -30% auto;width:70%;aspect-ratio:1;border-radius:50%;background:rgba(255,255,255,.14)}
    .hero .art::after{content:"";position:absolute;left:8%;top:10%;width:38%;aspect-ratio:1;border-radius:50%;background:rgba(255,255,255,.18);filter:blur(1px)}
    .hero .art span{position:absolute;left:24px;bottom:20px;color:#fff;font-family:"Fraunces",Georgia,serif;font-size:clamp(3rem,8vw,6rem);font-weight:600;line-height:1;opacity:.95;text-shadow:0 2px 20px rgba(0,0,0,.18)}
    section{padding:clamp(28px,4vw,48px) 0}section.alt{background:var(--panel);border:1px solid var(--line);border-radius:24px;padding:clamp(24px,4vw,40px);margin:8px 0}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin-top:22px}
    .card{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:22px 22px 20px;position:relative}
    .card::before{content:"";position:absolute;left:22px;top:0;width:44px;height:3px;border-radius:0 0 3px 3px;background:var(--accent)}
    .card h3{margin:8px 0 8px}.card p{margin:0;color:var(--muted)}
    section.alt .card{background:var(--panel-2);border-color:transparent}
    .about{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(24px,5vw,64px);align-items:start}@media (max-width:820px){.about{grid-template-columns:minmax(0,1fr)}}
    .about blockquote{margin:0;padding:22px 26px;border-left:4px solid var(--accent);background:var(--panel);border-radius:0 var(--r) var(--r) 0;font-family:"Fraunces",Georgia,serif;font-size:1.25rem;line-height:1.45}
    /* formulaire */
    form.lead,form#checkout-form{display:grid;gap:14px;max-width:600px;background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:24px}
    label{display:grid;gap:6px;font-size:.88rem;font-weight:600;color:var(--muted)}
    input,textarea{width:100%;font:inherit;font-weight:500;padding:12px 14px;border:1.5px solid var(--line);border-radius:12px;background:#fff;color:var(--ink)}input:focus,textarea:focus{border-color:var(--accent);outline:0}textarea{min-height:130px;resize:vertical}
    .check{display:flex;gap:10px;align-items:flex-start;font-weight:500;font-size:.88rem}.check input{width:auto;margin-top:4px}
    /* boutique */
    .products{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:18px;margin:8px 0 12px}
    .product{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column;transition:transform .15s,box-shadow .15s}.product:hover{transform:translateY(-2px);box-shadow:0 18px 40px -24px rgba(27,29,34,.35)}
    .ph{aspect-ratio:4/3;display:grid;place-items:center;text-decoration:none;position:relative;overflow:hidden;background:linear-gradient(140deg,color-mix(in srgb,var(--accent) 22%,#fff),color-mix(in srgb,var(--accent) 60%,#fff))}
    .ph::after{content:"";position:absolute;right:-18%;bottom:-30%;width:70%;aspect-ratio:1;border-radius:50%;background:rgba(255,255,255,.35)}
    .ph.has-img::after{display:none}.ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
    .ph span{position:relative;font-family:"Fraunces",Georgia,serif;font-size:3.2rem;font-weight:600;color:var(--accent);opacity:.9}
    .product .b{padding:16px 18px 18px;display:flex;flex-direction:column;gap:6px;flex:1}.product h3{margin:0;font-size:1.1rem}.product h3 a{text-decoration:none}.product p{margin:0;color:var(--muted);font-size:.92rem;flex:1}
    .product .row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:8px}
    .price{font-weight:700;font-size:1.1rem;font-variant-numeric:tabular-nums;white-space:nowrap}.stock{font-size:.8rem;color:var(--faint)}
    .product-hero{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:clamp(24px,5vw,56px);align-items:start;padding:clamp(24px,4vw,48px) 0}@media (max-width:820px){.product-hero{grid-template-columns:minmax(0,1fr)}}
    .product-hero .ph{aspect-ratio:1;border-radius:24px}
    table.cart{width:100%;border-collapse:collapse;background:var(--panel);border:1px solid var(--line);border-radius:var(--r);overflow:hidden}table.cart td{padding:14px 16px;border-bottom:1px solid var(--line);vertical-align:middle}table.cart tr:last-child td{border-bottom:0}table.cart input{width:72px;padding:8px 10px}
    .totals{display:grid;grid-template-columns:1fr auto;gap:8px 24px;max-width:380px;margin:18px 0 0 auto;font-variant-numeric:tabular-nums}.totals b{font-size:1.2rem}
    fieldset{border:1.5px solid var(--line);border-radius:12px;padding:12px 16px;display:grid;gap:8px}legend{padding:0 6px;font-size:.85rem;color:var(--muted)}
    footer.foot{border-top:1px solid var(--line);margin-top:48px;padding:26px 0 44px;font-size:.88rem;color:var(--muted);display:flex;gap:16px;flex-wrap:wrap;justify-content:space-between;align-items:center}
    footer.foot a{color:var(--muted);text-decoration:none}footer.foot a:hover{color:var(--ink)}footer.foot .made{font-size:.78rem;color:var(--faint)}
    @media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto}}
  </style>
</head>
<body>
  <div class="wrap">
    <header class="top"><a class="brand" href={p + '/'}><i>{company.name.trim().slice(0, 1)}</i>{company.name}</a><nav>{shopEnabled ? <a href={p + '/shop/'}>{T.nav_shop}</a> : null}{hasServices ? <a href={p + '/#services'}>{T.nav_services}</a> : null}{hasAbout ? <a href={p + '/#about'}>{T.nav_about}</a> : null}<a href={p + '/contact/'}>{T.nav_contact}</a>{shopEnabled ? <a class="basket" href={p + '/shop/panier/'} id="basket-link">{T.basket}<b id="basket-count">0</b></a> : null}{LANGS.filter(l => l !== lang).map(l => <a class="lang" href={prefix(l) + path} hreflang={l}>{UI[l].lang_name}</a>)}</nav></header>
    <slot />
    <footer class="foot">
      <span>© {new Date().getFullYear()} {company.name} · {company.contact?.city} <span class="made">· <a href="https://myaicompany.ch">MyAiCompany</a></span></span>
      <span>{shopEnabled ? <><a href={p + '/cgv/'}>{T.legal_cgv}</a> · </> : null}<a href={p + '/mentions-legales/'}>{T.legal}</a> · <a href={p + '/confidentialite/'}>{T.privacy}</a> · <a href={p + '/contact/'}>{T.contact}</a></span>
    </footer>
  </div>
  {shopEnabled ? <script>try{const c=JSON.parse(localStorage.getItem('maic-basket')||'[]');const n=c.reduce((a,i)=>a+i.qty,0);const e=document.getElementById('basket-count');if(e)e.textContent=n;}catch(e){}</script> : null}
</body>
</html>
