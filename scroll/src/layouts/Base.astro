---
// Gabarit commun à toutes les pages : <head> (canonical, hreflang, Open Graph, JSON-LD LocalBusiness), polices et tokens du
// thème (src/themes/), CSS du moteur (inline, dans cet ordre : polices → tokens → base → engine → motion → thème), en-tête,
// pied de page, compteur du panier, chatbot d'accueil. Aucune ressource distante.
import { company, site, LANGS, DEFAULT, UI, prefix, tagline, shopEnabled, content, agenda, theme } from '../site.js';
import { fontCss, tokenCss } from '../themes/index.js';
import engineCss from '../engine/engine.css?inline';
import motionCss from '../engine/motion.css?inline';
const { title, description, noindex = false, lang = DEFAULT, path = '/', image = null, full = false } = Astro.props;
const T = UI[lang] || UI.fr; const p = prefix(lang); const tg = tagline(lang);
const PAGES = Object.entries(content(lang).pages || {});   // pages libres (site.page) : un lien de navigation par page
const alt = LANGS.map(l => ({ l, href: site + prefix(l) + path }));
const LOCALE = { fr: 'fr_CH', en: 'en_GB', de: 'de_CH', it: 'it_CH' }[lang] || 'fr_CH';
const head = fontCss(theme) + tokenCss(theme, company.accent) + `
/* --- base du kit (toutes les pages) --- */
*{box-sizing:border-box}html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}html,body{margin:0}
body{background:var(--c-bg);color:var(--c-ink);font:16px/1.6 var(--font-text);-webkit-font-smoothing:antialiased;overflow-x:clip}
a{color:inherit}img,video{max-width:100%;height:auto}
h1,h2,h3{font-family:var(--font-display);font-weight:600;letter-spacing:-.015em;text-wrap:balance;margin:0}
h1{font-size:clamp(2.4rem,5.5vw,4rem);line-height:1.02}h1.page{font-size:clamp(2rem,4vw,3rem);margin-bottom:10px}h2{font-size:clamp(1.7rem,3.2vw,2.5rem);line-height:1.1;margin-bottom:14px}h3{font-size:1.15rem;line-height:1.3}
p{margin:0 0 12px}.note{font-size:.9rem;color:var(--c-muted)}.muted{color:var(--c-muted)}.small{font-size:.9rem}
.wrap{max-width:1140px;margin:0 auto;padding:0 clamp(18px,4vw,40px)}
main.page{padding-bottom:24px}
header.top{display:flex;align-items:center;gap:18px;padding:20px clamp(18px,4vw,40px);flex-wrap:wrap;max-width:1140px;margin:0 auto;box-sizing:border-box;width:100%}
header.top .brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-family:var(--font-display);font-weight:600;font-size:1.25rem;letter-spacing:-.01em}
header.top .brand i{width:34px;height:34px;border-radius:calc(var(--r-card) * .6);background:var(--c-accent);color:var(--c-accent-ink);display:grid;place-items:center;font-style:normal;font-weight:700;font-size:1rem;font-family:var(--font-text)}
header.top nav{margin-left:auto;display:flex;gap:2px;align-items:center;flex-wrap:wrap}
header.top nav a{text-decoration:none;color:inherit;opacity:.78;font-weight:600;font-size:.93rem;padding:8px 12px;border-radius:999px}header.top nav a:hover{opacity:1;background:color-mix(in srgb,currentColor 9%,transparent)}
header.top nav .lang{border:1px solid color-mix(in srgb,currentColor 30%,transparent);font-size:.82rem;padding:5px 10px;margin-left:6px}
header.top nav .basket b{background:var(--c-accent);color:var(--c-accent-ink);border-radius:999px;padding:1px 8px;font-size:.8rem;margin-left:4px}
body.is-home[data-hero="full"] header.top,body.is-home[data-hero="type"] header.top{position:absolute;top:0;left:0;right:0;z-index:10}
body.is-home[data-hero="full"] header.top{color:var(--c-hero-ink,#fff)}
body.is-home[data-hero="full"] header.top .brand i{background:var(--c-hero-ink,#fff);color:var(--c-hero-a)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--c-ink);color:var(--c-bg);text-decoration:none;padding:14px 24px;border-radius:var(--r-btn);font:inherit;font-weight:700;border:0;cursor:pointer;line-height:1.1;transition:transform .15s,background .15s,color .15s}
.btn:hover{background:var(--c-accent);color:var(--c-accent-ink);transform:translateY(-1px)}.btn.sm{padding:9px 15px;font-size:.92rem;white-space:nowrap}.btn.big{padding:16px 28px}
.btn.ghost{background:transparent;color:inherit;border:1.5px solid color-mix(in srgb,currentColor 35%,transparent)}.btn.ghost:hover{background:color-mix(in srgb,currentColor 8%,transparent);color:inherit;border-color:currentColor}
.btn:disabled{opacity:.45;cursor:default;transform:none}
.btn:focus-visible,a:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible,button:focus-visible,summary:focus-visible{outline:2px solid var(--c-accent);outline-offset:3px}
/* en-tête des pages intérieures */
.page-hero{padding:clamp(28px,5vw,56px) 0 clamp(20px,3vw,32px);max-width:62ch}.page-hero p{color:var(--c-muted);font-size:1.05rem}.page-hero .lead{font-size:clamp(1.05rem,1.5vw,1.25rem)}.page-hero .cta{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}
section{padding:clamp(20px,3vw,36px) 0}section.alt{background:var(--c-panel);border:1px solid var(--c-line);border-radius:var(--r-card);padding:clamp(22px,3vw,36px);margin:8px 0}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin-top:22px}
.card{background:var(--c-panel);border:1px solid var(--c-line);border-radius:var(--r-card);padding:22px 22px 20px;position:relative}
.card h3{margin:8px 0 8px}.card p{margin:0;color:var(--c-muted)}
/* formulaires */
form.lead,form#checkout-form,form.join-form{display:grid;gap:14px;max-width:640px;background:var(--c-panel);border:1px solid var(--c-line);border-radius:var(--r-card);padding:24px}
form.join-form .row{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;align-items:end}form.join-form .f{display:grid;gap:6px}form.join-form .f.wide{grid-column:1/-1}
label{display:grid;gap:6px;font-size:.88rem;font-weight:600;color:var(--c-muted)}
input,textarea,select{width:100%;font:inherit;font-weight:500;padding:12px 14px;border:1.5px solid var(--c-line);border-radius:calc(var(--r-card) * .6);background:var(--c-bg);color:var(--c-ink)}input:focus,textarea:focus,select:focus{border-color:var(--c-accent);outline:0}textarea{min-height:130px;resize:vertical}
.check{display:flex;gap:10px;align-items:flex-start;font-weight:500;font-size:.88rem}.check input{width:auto;margin-top:4px}
/* boutique (kit vitrine, tokenisée) */
.products{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:18px;margin:8px 0 12px}
.product{background:var(--c-panel);border:1px solid var(--c-line);border-radius:var(--r-card);overflow:hidden;display:flex;flex-direction:column;transition:transform .15s,box-shadow .15s}.product:hover{transform:translateY(-2px);box-shadow:var(--shadow)}
.ph{aspect-ratio:4/3;display:grid;place-items:center;text-decoration:none;position:relative;overflow:hidden;background:linear-gradient(140deg,color-mix(in srgb,var(--c-accent) 22%,var(--c-bg)),color-mix(in srgb,var(--c-accent) 60%,var(--c-bg)))}
.ph::after{content:"";position:absolute;right:-18%;bottom:-30%;width:70%;aspect-ratio:1;border-radius:50%;background:rgba(255,255,255,.3)}
.ph.has-img::after{display:none}.ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.ph span{position:relative;font-family:var(--font-display);font-size:3.2rem;font-weight:600;color:var(--c-accent);opacity:.9}
.product .b{padding:16px 18px 18px;display:flex;flex-direction:column;gap:6px;flex:1}.product h3{margin:0;font-size:1.1rem}.product h3 a{text-decoration:none}.product p{margin:0;color:var(--c-muted);font-size:.92rem;flex:1}
.product .row{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:8px}
.price{font-weight:700;font-size:1.1rem;font-variant-numeric:tabular-nums;white-space:nowrap}.stock{font-size:.8rem;color:var(--c-muted)}
.product-hero{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:clamp(24px,5vw,56px);align-items:start;padding:clamp(24px,4vw,48px) 0}@media (max-width:820px){.product-hero{grid-template-columns:minmax(0,1fr)}}
.product-hero .ph{aspect-ratio:1;border-radius:var(--r-card)}
table.cart{width:100%;border-collapse:collapse;background:var(--c-panel);border:1px solid var(--c-line);border-radius:var(--r-card);overflow:hidden}table.cart td{padding:14px 16px;border-bottom:1px solid var(--c-line);vertical-align:middle}table.cart tr:last-child td{border-bottom:0}table.cart input{width:72px;padding:8px 10px}
.totals{display:grid;grid-template-columns:1fr auto;gap:8px 24px;max-width:380px;margin:18px 0 0 auto;font-variant-numeric:tabular-nums}.totals b{font-size:1.2rem}
fieldset{border:1.5px solid var(--c-line);border-radius:12px;padding:12px 16px;display:grid;gap:8px}legend{padding:0 6px;font-size:.85rem;color:var(--c-muted)}
footer.foot{border-top:1px solid var(--c-line);margin-top:48px;padding:26px clamp(18px,4vw,40px) 44px;font-size:.88rem;color:var(--c-muted);display:flex;gap:16px;flex-wrap:wrap;justify-content:space-between;align-items:center;max-width:1140px;margin-left:auto;margin-right:auto;box-sizing:border-box}
footer.foot a{color:var(--c-muted);text-decoration:none}footer.foot a:hover{color:var(--c-ink)}footer.foot .made{font-size:.78rem;opacity:.8}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important;scroll-behavior:auto}}
` + engineCss + motionCss + (theme.css || '');
---
<!doctype html>
<html lang={lang} data-theme={theme.name} data-mood={theme.mood || 'light'} data-motion={theme.motion || 'rise'}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title ? `${title} · ${company.name}` : `${company.name} — ${tg}`}</title>
  <meta name="description" content={description || tg}>
  <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'}>
  <meta name="theme-color" content={(theme.colors || {}).bg || '#ffffff'}>
  <link rel="canonical" href={site + p + path}>
  {alt.map(a => <link rel="alternate" hreflang={a.l} href={a.href} />)}
  <link rel="alternate" hreflang="x-default" href={site + path}>
  <meta property="og:title" content={title || company.name}><meta property="og:description" content={description || tg}><meta property="og:type" content="website"><meta property="og:url" content={site + p + path}><meta property="og:site_name" content={company.name}>{image ? <meta property="og:image" content={site + image} /> : null}<meta property="og:locale" content={LOCALE}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"LocalBusiness","name":company.name,"description":tg,"url":site,"email":company.contact?.email,"telephone":company.contact?.phone || undefined,"address":{"@type":"PostalAddress","addressLocality":company.contact?.city,"addressCountry":"CH"}})}></script>
  <style is:inline set:html={head}></style>
</head>
<body class={full ? 'is-home' : ''} data-hero={full ? theme.hero : undefined}>
  <header class="top"><a class="brand" href={p + '/'}><i>{company.name.trim().slice(0, 1)}</i>{company.name}</a><nav aria-label="Navigation">{shopEnabled ? <a href={p + '/shop/'}>{T.nav_shop}</a> : null}<a href={p + '/#services'}>{T.nav_services}</a><a href={p + '/#about'}>{T.nav_about}</a>{PAGES.map(([s, pg]) => <a href={p + '/p/' + s + '/'}>{pg.nav || pg.title}</a>)}{agenda.on ? <a href={p + '/reserver/'}>{T.nav_book}</a> : null}<a href={p + '/contact/'}>{T.nav_contact}</a>{shopEnabled ? <a class="basket" href={p + '/shop/panier/'} id="basket-link">{T.basket}<b id="basket-count">0</b></a> : null}{LANGS.filter(l => l !== lang).map(l => <a class="lang" href={prefix(l) + path} hreflang={l} lang={l}>{(UI[l] || {}).lang_name || l.toUpperCase()}</a>)}</nav></header>
  <main class={full ? '' : 'wrap page'}><slot /></main>
  <footer class="foot">
    <span>© {new Date().getFullYear()} {company.name} · {company.contact?.city} <span class="made">· <a href="https://myaicompany.io">MyAiCompany</a></span></span>
    <span>{shopEnabled ? <><a href={p + '/cgv/'}>{T.legal_cgv}</a> · </> : null}<a href={p + '/mentions-legales/'}>{T.legal}</a> · <a href={p + '/confidentialite/'}>{T.privacy}</a> · <a href={p + '/contact/'}>{T.contact}</a></span>
  </footer>
  {shopEnabled ? <script is:inline>try{const c=JSON.parse(localStorage.getItem('maic-basket')||'[]');const n=c.reduce((a,i)=>a+i.qty,0);const e=document.getElementById('basket-count');if(e)e.textContent=n;}catch(e){}</script> : null}
  {/* Le chatbot d'accueil : toujours chargé, ne se montre que si la compagnie a la capacité « Accueil » (le fichier se termine sans rien ajouter sinon). */}
  <script src="/chat/widget.js" data-lang={lang} defer></script>
</body>
</html>
