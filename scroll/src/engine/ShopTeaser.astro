---
// ShopTeaser — la boutique sur la home : jusqu'à quatre produits du catalogue (catalog.json, écrit par la plateforme avant le
// build : `p.image` = /api/public/media/<id> déjà résolu, `p.i18n` = fiches traduites) en cartes du thème — image carrée
// (repli : l'initiale sur la matière du thème, comme /shop/), nom, prix `chf()`, stock ou « sur devis », « Voir » (fiche
// /shop/produit/<id>/) et « Ajouter » (même panier localStorage `maic-basket` que shop/index.astro, même compteur d'en-tête).
// Apparition pilotée par le défilement : la section est un `reveal`, chaque carte décale son entrée (--i, motion.css).
// Mobile : rail horizontal défilable au doigt (scroll-snap). Clés content.yaml : shop.title/text/cta/add/soldout (+ kicker).
// La section n'existe que si la compagnie a au moins un produit actif ET shop.title (Home.astro → has.shop).
import { products, prodText, chf } from '../site.js';
const { C, T, lang, alt, prefix } = Astro.props;
const S = C.shop || {}; const items = products.slice(0, 4);
const initial = n => String(n).replace(/[«»"“”]/g, '').trim().slice(0, 1).toUpperCase();
const stockLabel = p => p.stock === null || p.stock === undefined ? T.made_to_order : p.stock > 0 ? `${p.stock} ${T.in_stock}` : (S.soldout || 'Épuisé');
const all = prefix + '/shop/'; const allLabel = S.cta || T.nav_shop;
---
<section id="shop" class={`shopt sec${alt ? ' sec--alt' : ''}`} data-scroll="reveal" data-n={items.length} aria-labelledby="shop-title">
  <div class="wrap">
    <header class="sec__head shopt__head">
      <div>{S.kicker ? <p class="kicker">{S.kicker}</p> : null}<h2 id="shop-title">{S.title}</h2>{S.text ? <p>{S.text}</p> : null}</div>
      <a class="btn ghost shopt__all" href={all}>{allLabel}</a>
    </header>
    <ul class="shopt__grid">
      {items.map((p, i) => { const t = prodText(p, lang); const href = `${prefix}/shop/produit/${p.id}/`; return (
        <li class="shopt__card" style={`--i:${i}`}>
          <a class={`shopt__ph${p.image ? ' has-img' : ''}`} href={href} aria-label={t.name}>
            <span class="shopt__initial" aria-hidden="true">{initial(p.name)}</span>
            {p.image ? <img src={p.image} alt="" loading="lazy" decoding="async" onerror="this.parentNode.classList.remove('has-img');this.remove()" /> : null}
          </a>
          <div class="shopt__body">
            <h3><a href={href}>{t.name}</a></h3>
            {t.description ? <p>{t.description}</p> : null}
            <div class="shopt__meta"><span class="shopt__price">{chf(p.price_cents)} CHF</span><span class="shopt__stock">{stockLabel(p)}</span></div>
            <div class="shopt__actions">
              <a class="btn sm ghost" href={href}>{T.shop_view}</a>
              <button class="btn sm" type="button" data-add={p.id} data-name={t.name} data-price={p.price_cents} disabled={p.stock === 0}>{S.add || 'Ajouter'}</button>
            </div>
          </div>
        </li>); })}
    </ul>
    <p class="shopt__foot"><a class="btn" href={all}>{allLabel}</a></p>
  </div>
  <script>
    // même mécanique que shop/index.astro : panier dans localStorage, compteur #basket-count de l'en-tête, ✓ pendant 0,9 s
    document.querySelectorAll('.shopt [data-add]').forEach(b => b.addEventListener('click', () => { let c = []; try { c = JSON.parse(localStorage.getItem('maic-basket') || '[]'); } catch (e) {} const id = +b.dataset.add, it = c.find(i => i.id === id); if (it) it.qty++; else c.push({ id, name: b.dataset.name, price_cents: +b.dataset.price, qty: 1 }); localStorage.setItem('maic-basket', JSON.stringify(c)); const e = document.getElementById('basket-count'); if (e) e.textContent = c.reduce((a, i) => a + i.qty, 0); const l = b.textContent; b.textContent = '✓'; setTimeout(() => { b.textContent = l; }, 900); }));
  </script>
</section>
