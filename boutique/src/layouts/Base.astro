---
import { company, site, LANGS, DEFAULT, UI, prefix, tagline } from '../site.js';
const { title, description, noindex = false, lang = DEFAULT, path = '/' } = Astro.props;
const accent = company.accent || '#1E8C8A'; const T = UI[lang] || UI.fr; const p = prefix(lang); const tg = tagline(lang);
const alt = LANGS.map(l => ({ l, href: site + prefix(l) + path }));
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title ? `${title} · ${company.name}` : `${company.name} — ${tg}`}</title>
  <meta name="description" content={description || tg}>
  <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'}>
  <link rel="canonical" href={site + p + path}>
  {alt.map(a => <link rel="alternate" hreflang={a.l} href={a.href} />)}
  <link rel="alternate" hreflang="x-default" href={site + path}>
  <meta property="og:title" content={title || company.name}><meta property="og:description" content={description || tg}><meta property="og:type" content="website"><meta property="og:url" content={site + p + path}><meta property="og:site_name" content={company.name}><meta property="og:locale" content={lang === 'fr' ? 'fr_CH' : 'en_GB'}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@type":"LocalBusiness","name":company.name,"description":tg,"url":site,"email":company.contact?.email,"address":{"@type":"PostalAddress","addressLocality":company.contact?.city,"addressCountry":"CH"}})}></script>
  <style define:vars={{ accent }}>
    :root{--ink:#171A20;--muted:#6B7180;--bg:#FBFAF8;--panel:#fff;--line:#E6E3DD}
    *{box-sizing:border-box}html,body{margin:0}
    body{background:var(--bg);color:var(--ink);font:17px/1.6 system-ui,-apple-system,"Segoe UI",sans-serif;padding:0 16px}
    a{color:inherit}
    .wrap{max-width:960px;margin:0 auto}
    header{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 0;flex-wrap:wrap}
    header .brand{font-weight:700;letter-spacing:-.01em;text-decoration:none;font-size:1.1rem}
    header nav{display:flex;gap:18px;font-size:.95rem;align-items:center}header nav a{text-decoration:none;color:var(--muted)}header nav a:hover{color:var(--ink)}
    header nav .lang{font-size:.8rem;border:1px solid var(--line);border-radius:999px;padding:3px 9px}
    .btn{display:inline-block;background:var(--accent);color:#fff;text-decoration:none;padding:12px 20px;border-radius:999px;font-weight:600;border:0;font:inherit;cursor:pointer}
    .btn:hover{filter:brightness(.92)}
    h1{font-size:clamp(2rem,5vw,3.2rem);line-height:1.08;letter-spacing:-.02em;margin:0 0 16px;text-wrap:balance}
    h2{font-size:1.6rem;letter-spacing:-.01em;margin:0 0 10px}
    .hero{padding:56px 0 40px;max-width:640px}.hero p{font-size:1.15rem;color:var(--muted);margin:0 0 24px}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin:32px 0}
    .card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:22px}.card h3{margin:0 0 6px;font-size:1.05rem}.card p{margin:0;color:var(--muted)}
    section{padding:32px 0}
    footer{border-top:1px solid var(--line);margin-top:48px;padding:24px 0 40px;font-size:.85rem;color:var(--muted);display:flex;gap:16px;flex-wrap:wrap;justify-content:space-between}
    footer a{color:var(--muted)}
    form{display:grid;gap:12px;max-width:560px}label{display:grid;gap:4px;font-size:.9rem;color:var(--muted)}
    input,textarea{width:100%;font:inherit;padding:11px 13px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}textarea{min-height:120px;resize:vertical}
    .note{font-size:.9rem;color:var(--muted)}
    .products{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:18px;margin:24px 0}
    .product{background:var(--panel);border:1px solid var(--line);border-radius:14px;overflow:hidden;display:flex;flex-direction:column}
    .product .ph{aspect-ratio:4/3;background:linear-gradient(135deg,#F1EDE6,#E3DDD3);display:grid;place-items:center;color:var(--muted);font-size:.85rem}
    .product .b{padding:14px 16px 16px;display:flex;flex-direction:column;gap:6px;flex:1}
    .product h3{margin:0;font-size:1.05rem}.product p{margin:0;color:var(--muted);font-size:.92rem;flex:1}
    .price{font-weight:700;font-size:1.1rem}.stock{font-size:.8rem;color:var(--muted)}
    .btn.sm{padding:9px 14px;font-size:.92rem}.btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
    table.cart{width:100%;border-collapse:collapse}table.cart td{padding:10px 6px;border-bottom:1px solid var(--line);vertical-align:middle}
    .totals{display:grid;grid-template-columns:1fr auto;gap:6px 18px;max-width:360px;margin:16px 0 0 auto}.totals b{font-size:1.15rem}
  </style>
</head>
<body>
  <div class="wrap">
    <header><a class="brand" href={p + '/'}>{company.name}</a><nav><a href={p + '/boutique/'}>{T.nav_shop}</a><a href={p + '/#services'}>{T.nav_services}</a><a href={p + '/#about'}>{T.nav_about}</a><a href={p + '/contact/'}>{T.nav_contact}</a><a href={p + '/panier/'} id="basket-link" style="font-weight:600">{T.basket} <span id="basket-count" style="background:var(--accent);color:#fff;border-radius:999px;padding:1px 7px;font-size:.8rem">0</span></a>{LANGS.filter(l => l !== lang).map(l => <a class="lang" href={prefix(l) + path} hreflang={l}>{UI[l].lang_name}</a>)}</nav></header>
    <slot />
    <footer>
      <span>© {new Date().getFullYear()} {company.name} · {company.contact?.city}</span>
      <span><a href={p + '/cgv/'}>{T.legal_cgv}</a> · <a href={p + '/mentions-legales/'}>{T.legal}</a> · <a href={p + '/confidentialite/'}>{T.privacy}</a> · <a href={p + '/contact/'}>{T.contact}</a></span>
    </footer>
  </div>
  <script>try{const c=JSON.parse(localStorage.getItem('maic-basket')||'[]');const n=c.reduce((a,i)=>a+i.qty,0);const e=document.getElementById('basket-count');if(e)e.textContent=n;}catch(e){}</script>
</body>
</html>
