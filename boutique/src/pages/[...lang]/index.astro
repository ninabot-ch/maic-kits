---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import Basket from '../../components/Basket.astro';
import { products, shop, chf } from '../../site.js';
import { company, content, LANGS, DEFAULT, UI } from '../../site.js';
export function getStaticPaths() { return LANGS.map(l => ({ params: { lang: l === DEFAULT ? undefined : l }, props: { lang: l } })); }
const { lang } = Astro.props; const C = content(lang); const T = UI[lang] || UI.fr;
---
<Base lang={lang} path="/">
  <section class="hero"><h1>{C.hero.title}</h1><p>{C.hero.text}</p><a class="btn" href={(lang === DEFAULT ? '' : '/' + lang) + '/boutique/'}>{C.shop?.cta || T.nav_shop}</a></section>
  <section id="shop"><h2>{C.shop?.title || T.nav_shop}</h2><p class="note">{C.shop?.text}</p>
    <div class="products">{products.slice(0, 6).map(p => <div class="product"><a class="ph" href={(lang === DEFAULT ? '' : '/' + lang) + '/produit/' + p.id + '/'}>{p.name}</a><div class="b"><h3>{p.name}</h3><p>{p.description}</p><div class="price">{chf(p.price_cents)} CHF</div><span class="stock">{p.stock === null || p.stock === undefined ? T.made_to_order : p.stock > 0 ? `${p.stock} ${T.in_stock}` : (C.shop?.soldout || 'Épuisé')}</span><button class="btn sm" type="button" data-add={p.id} data-name={p.name} data-price={p.price_cents} disabled={p.stock === 0}>{C.shop?.add || 'Ajouter'}</button></div></div>)}</div>
    <p class="note">{shop.vat_registered ? T.vat_note_reg : T.vat_note}</p>
  </section>
  <section id="services"><h2>{C.services_title}</h2><div class="grid">{C.services.map(s => <div class="card"><h3>{s.title}</h3><p>{s.text}</p></div>)}</div></section>
  <section id="about"><h2>{C.about.title}</h2><p>{C.about.text}</p></section>
  <ContactForm lang={lang} title={C.contact.title} text={C.contact.text} />
  <script>
    document.querySelectorAll('[data-add]').forEach(b => b.addEventListener('click', () => { let c = []; try { c = JSON.parse(localStorage.getItem('maic-basket') || '[]'); } catch (e) {} const id = +b.dataset.add, it = c.find(i => i.id === id); if (it) it.qty++; else c.push({ id, name: b.dataset.name, price_cents: +b.dataset.price, qty: 1 }); localStorage.setItem('maic-basket', JSON.stringify(c)); const e = document.getElementById('basket-count'); if (e) e.textContent = c.reduce((a, i) => a + i.qty, 0); b.textContent = '✓'; setTimeout(() => { b.textContent = b.dataset.label || b.textContent; }, 900); }));
  </script>
</Base>
