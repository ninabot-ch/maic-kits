---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import Basket from '../../components/Basket.astro';
import { products, shop, chf } from '../../site.js';
import { company, content, LANGS, DEFAULT, UI, tagline } from '../../site.js';
export function getStaticPaths() { return LANGS.map(l => ({ params: { lang: l === DEFAULT ? undefined : l }, props: { lang: l } })); }
const { lang } = Astro.props; const C = content(lang); const T = UI[lang] || UI.fr; const PFX = lang === DEFAULT ? '' : '/' + lang;
// Un site neuf n'a AUCUN contenu (content.yaml est vide par construction) : on n'affiche que les
// sections que son propriétaire a réellement publiées, jamais un titre vide ni une carte vide.
const has = v => typeof v === 'string' && v.trim().length > 0;
const services = (C.services || []).filter(s => has(s?.title) || has(s?.text));
---
<Base lang={lang} path="/">
  <section class="hero"><div><p class="kicker">{tagline(lang)}</p>{has(C.hero.title) ? <h1>{C.hero.title}</h1> : <h1>{company.name}</h1>}{has(C.hero.text) ? <p class="lead">{C.hero.text}</p> : null}<div class="cta">{has(C.hero.cta) ? <a class="btn" href={PFX + '/contact/'}>{C.hero.cta}</a> : null}<a class="btn ghost" href={PFX + '/boutique/'}>{T.nav_shop}</a></div></div><div class="art" aria-hidden="true"><span>{company.name.trim().slice(0, 1)}</span></div></section>
  {services.length ? <section id="services" class="alt">{has(C.services_title) ? <h2>{C.services_title}</h2> : null}<div class="grid">{services.map(s => <div class="card">{has(s.title) ? <h3>{s.title}</h3> : null}{has(s.text) ? <p>{s.text}</p> : null}</div>)}</div></section> : null}
  {(has(C.about.title) || has(C.about.text)) ? <section id="about"><div class="about"><div>{has(C.about.title) ? <h2>{C.about.title}</h2> : null}{has(C.about.text) ? <p class="note" style="font-size:1rem">{C.about.text}</p> : null}</div>{has(C.hero.title) ? <blockquote>{C.hero.title}</blockquote> : null}</div></section> : null}
  {(has(C.contact.title) || has(C.contact.text)) ? <ContactForm lang={lang} title={C.contact.title} text={C.contact.text} /> : null}
  <script>
    document.querySelectorAll('[data-add]').forEach(b => b.addEventListener('click', () => { let c = []; try { c = JSON.parse(localStorage.getItem('maic-basket') || '[]'); } catch (e) {} const id = +b.dataset.add, it = c.find(i => i.id === id); if (it) it.qty++; else c.push({ id, name: b.dataset.name, price_cents: +b.dataset.price, qty: 1 }); localStorage.setItem('maic-basket', JSON.stringify(c)); const e = document.getElementById('basket-count'); if (e) e.textContent = c.reduce((a, i) => a + i.qty, 0); b.textContent = '✓'; setTimeout(() => { b.textContent = b.dataset.label || b.textContent; }, 900); }));
  </script>
</Base>
